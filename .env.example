# Flask Runtime Settings
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1

# Application Security
# Generate a secure secret key in production (e.g., using secrets.token_hex(32))
SECRET_KEY=replace-with-a-secure-random-secret-key-min-32-chars

# Database Connection URI
# Local development uses SQLite; Production (Render) overrides this with PostgreSQL
DATABASE_URL=sqlite:///tindamind.db